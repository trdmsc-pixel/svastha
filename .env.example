# Client (Expo / Vercel)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
EXPO_PUBLIC_ASSETS_CDN_BASE=https://cdn.jsdelivr.net/gh/trdmsc-pixel/svastha-assets@v1

# Server (Supabase Edge Function Secrets — NEVER put in Expo client!)
# Set via: supabase secrets set KEY=value
LLM_PROVIDER=gemini
LLM_API_KEY=YOUR_GEMINI_OR_OPENAI_API_KEY
LLM_VISION_MODEL=gemini-2.5-flash
LLM_TEXT_MODEL=gemini-2.5-flash
EXPO_PUSH_ACCESS_TOKEN=YOUR_EXPO_PUSH_TOKEN
