{
  "expo": {
    "name": "Svastha",
    "slug": "swastha",
    "scheme": "svastha",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "backgroundColor": "#F6F2ED",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2F2B28"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.svastha.app",
      "icon": "./assets/icon.png",
      "infoPlist": {
        "NSCameraUsageDescription": "Svastha uses the camera to scan meals and lab reports. Photos are processed in memory and never stored.",
        "NSPhotoLibraryUsageDescription": "Svastha accesses photos you pick to scan a meal or lab report.",
        "NSCalendarsUsageDescription": "Svastha creates a dedicated Svastha calendar to sync your routines, meals, medicines, and retest date.",
        "NSFaceIDUsageDescription": "Unlock Svastha with Face ID to protect your personal health data."
      }
    },
    "android": {
      "package": "com.svastha.app",
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2F2B28"
      },
      "permissions": [
        "CAMERA",
        "READ_CALENDAR",
        "WRITE_CALENDAR",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      "expo-local-authentication",
      "expo-notifications",
      "expo-calendar",
      "expo-camera",
      "expo-image-picker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
